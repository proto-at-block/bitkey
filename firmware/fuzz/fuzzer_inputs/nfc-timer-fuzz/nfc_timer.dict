# NFC timer index dictionary for nfc-timer-fuzz.
# Key index values that exercise BCW-05 boundary conditions.

# index == 0: ST-RFAL special case (safe, returns immediately)
kw0="\x00\x00\x00\x00"

# index == 999: one below TIMER_INDEX_OFFSET (triggers ASSERT after subtraction wraps)
kw1="\xe7\x03\x00\x00"

# index == 1000: TIMER_INDEX_OFFSET + 0 (valid, timers[0])
kw2="\xe8\x03\x00\x00"

# index == 1009: TIMER_INDEX_OFFSET + MAX_NFC_TIMERS - 1 (valid, last timer)
kw3="\xf1\x03\x00\x00"

# index == 1010: TIMER_INDEX_OFFSET + MAX_NFC_TIMERS (OOB, triggers ASSERT)
kw4="\xf2\x03\x00\x00"

# index == UINT32_MAX (wraps to 0xFFFFF027 after subtraction, triggers ASSERT)
kw5="\xff\xff\xff\xff"
