{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // Migrated from block-renovate-config renovate/renovate-host-configs/wallet/default.js
  // ahead of the legacy pipeline decommission. Org-wide policy (registries, cooldown floors,
  // dependency dashboard) comes from the server-served config; everything repo-specific lives here.
  extends: [
    ':preserveSemverRanges',
    ':disableRateLimiting',
    ':semanticCommits',
    'github>Turbo87/renovate-config//rust/updateToolchain',
  ],
  labels: ['dependencies', 'task-list-completed-disable', 'do-not-mark-stale'],
  enabledManagers: [
    'cargo',
    'hermit',
    'custom.regex',
    'swift',
    'gradle',
    'dockerfile',
    'pip_requirements',
    'git-submodules',
  ],
  prConcurrentLimit: 5,
  prHourlyLimit: 10,
  recreateWhen: 'always',
  // cargo/swift/etc. default cooldown; the org config's per-datasource rules still apply on top
  minimumReleaseAge: '120 days',
  internalChecksFilter: 'strict',
  platformCommit: true,
  ignorePaths: ['docs/**', 'datadog/**', 'factory-test/**', 'fastlane/**', 'nodes/**', 'web/**'],
  prHeader: '### :warning: Please DO NOT merge this PR without first reviewing the build log and relevant status checks',
  packageRules: [
    {
      matchManagers: ['gradle'],
      postUpgradeTasks: {
        commands: ['. bin/activate-hermit && cd app && just update-gradle-lockfile'],
        fileFilters: ['app/gradle-lock/**/*.json'],
        executionMode: 'branch',
      },
    },
    {
      matchManagers: ['swift'],
      postUpgradeTasks: {
        commands: ['. bin/activate-hermit && cd app && just update-ios-lockfile'],
        fileFilters: [
          'app/ios/Package.lock',
          'app/ios/Wallet.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved',
        ],
        executionMode: 'branch',
      },
    },
    {
      matchManagers: ['hermit'],
      prBodyColumns: ['Package', 'Package file', 'Manager', 'Update', 'Change'],
      prBodyDefinitions: {
        Package: '{{{depNameLinked}}}',
        'Package file': '{{{packageFile}}}',
        Manager: '{{{manager}}}',
        Update: '{{{updateType}}}',
        Change: '`{{{displayFrom}}}` -> `{{{displayTo}}}`',
      },
      additionalBranchPrefix: 'hermit-',
    },
    {
      matchManagers: ['hermit'],
      defaultRegistryUrls: ['https://github.com/squareup/hermit-packages'],
    },
    // Firmware needs Python 3.10 or older
    {
      matchManagers: ['hermit'],
      matchPackageNames: ['python3'],
      allowedVersions: '<= 3.10',
    },
    // arm-gnu-gdb-python is a privately configured package in `firmware/bin/hermit-packages`
    {
      matchManagers: ['hermit'],
      matchPackageNames: ['arm-gnu-gdb-python'],
      enabled: false,
    },
    // Gradle updates should be manual
    {
      matchManagers: ['gradle'],
      matchFileNames: ['app/**'],
      matchPackageNames: ['com.android.tools.build:gradle'],
      enabled: false,
    },
    // FreeRTOS updates should be manual
    {
      matchManagers: ['git-submodules'],
      matchPackageNames: ['firmware/third-party/FreeRTOS'],
      enabled: false,
    },
    // BDK and bitcoin related packages should be updated manually
    {
      matchManagers: ['cargo'],
      matchPackageNames: ['bdk', 'bitcoin', 'miniscript', 'secp256k1'],
      enabled: false,
    },
    // Group related Rust package updates into the same PR
    {
      matchManagers: ['cargo'],
      matchPackageNames: ['/^futures[-_]?/'],
      groupName: 'futures packages',
    },
    {
      matchManagers: ['cargo'],
      matchPackageNames: ['/^opentelemetry[-_]?/', 'tracing-opentelemetry', 'axum-tracing-opentelemetry'],
      groupName: 'opentelemetry packages',
    },
    {
      matchManagers: ['cargo'],
      matchPackageNames: ['/^reqwest[-_]?/'],
      groupName: 'reqwest packages',
    },
    {
      matchManagers: ['cargo'],
      matchPackageNames: ['/^serde[-_]?/'],
      groupName: 'serde packages',
    },
    {
      matchManagers: ['cargo'],
      matchPackageNames: ['/^tracing[-_]?/', '!tracing-opentelemetry'],
      groupName: 'tracing packages',
    },
    // Group Rust toolchain and docker images
    {
      matchManagers: ['cargo', 'dockerfile'],
      matchPackageNames: ['rust', 'public.ecr.aws/docker/library/rust'],
      groupName: 'rust toolchain',
    },
    // Group alpine docker image for dockerhub and ecr registries
    {
      matchManagers: ['dockerfile'],
      matchPackageNames: ['alpine', 'public.ecr.aws/docker/library/alpine'],
      groupName: 'alpine docker image',
    },
    // Temporarily disable app dependency updates
    {
      matchManagers: ['gradle'],
      enabled: false,
    },
    {
      matchManagers: ['swift'],
      enabled: false,
    },
    {
      matchManagers: ['cargo'],
      matchFileNames: ['app/**'],
      enabled: false,
    },
  ],
}
