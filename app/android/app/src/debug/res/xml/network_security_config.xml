<?xml version="1.0" encoding="utf-8"?>

<network-security-config>
  <domain-config cleartextTrafficPermitted="true">
    <!-- Allow cleartext to 10.0.2.2 for local dev -->
    <domain includeSubdomains="true">10.0.2.2</domain>
    <!-- Allow cleartext to loopback for local dev: custom http://localhost
         F8e URLs, and emulator images that fail the isEmulator model heuristic
         (e.g. the AOSP "Android SDK built for x86_64" API-29 fallback on Blox,
         where local F8e is reached via `adb reverse`). The default Blox image
         (API-36 google_apis) passes the heuristic and uses 10.0.2.2 instead. -->
    <domain includeSubdomains="true">127.0.0.1</domain>
    <domain includeSubdomains="true">localhost</domain>
  </domain-config>

  <debug-overrides>
    <trust-anchors>
      <!-- Trust user added CAs while debuggable only -->
      <certificates src="user" />
      <certificates src="system" />
    </trust-anchors>
  </debug-overrides>

  <base-config cleartextTrafficPermitted="false">
    <!-- Secure defaults for all other traffic: HTTPS-only, system CAs only -->
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
