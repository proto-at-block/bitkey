DELETE FROM coachmarkEntity
WHERE id = 'PrivateWalletHomeCoachmark'
  AND EXISTS (
    SELECT 1
    FROM coachmarkEntity normalized
    WHERE normalized.id = 'private_wallet_home_coachmark'
  );

UPDATE coachmarkEntity
SET id = 'private_wallet_home_coachmark'
WHERE id = 'PrivateWalletHomeCoachmark';

