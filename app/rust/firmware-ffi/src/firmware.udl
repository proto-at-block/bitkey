[Enum]
interface ConfirmedCommandResult {
  WipeState(boolean success);
  FwupStart(boolean success);
  ChunkedDataAvailable(u32 total_size);
  SignActionProof(sequence<u8> signature);
  SignTx(sequence<InputSignatureTuple> signatures);
  SignStreamReady(u32 num_inputs);
  LostAppRecoverySsek(sequence<u8> ssek);
  LostAppRecoverySignChallenge(string signature);
  RotateAppAuthKeys(sequence<u8> action_proof_signature, sequence<u8> hw_signed_account_id, sequence<u8> app_auth_key_signature, sequence<u8> hw_auth_public_key);
  UpgradeRotateAppAuthKeys(sequence<u8> hw_signed_account_id, sequence<u8> app_auth_key_signature, sequence<u8> hw_auth_public_key);
  SignChallengeAndSealSeks(sequence<u8> signature, sequence<u8> sealed_csek, sequence<u8> sealed_ssek);
  RecoveryAuthorizeLostApp(sequence<u8> descriptor_backups_signature, sequence<u8> activate_keyset_signature, sequence<u8> unsealed_ddk_data, sequence<u8> unsealed_ssek);
  RecoveryAuthorizeLostHw(sequence<u8> descriptor_backups_signature, sequence<u8> activate_keyset_signature, sequence<u8> sealed_ddk_data);
  UpgradeAuthorizeW3(sequence<u8> descriptor_backups_signature, sequence<u8> activate_keyset_signature, sequence<u8> sealed_ddk_data);
  EekRestorationUnsealSymmetricKey(sequence<u8> unsealed_key);
  FullAccountCloudBackupRestoration();
};

