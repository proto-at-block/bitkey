dictionary TxSignature {
  sequence<u8> pubkey;
  sequence<u8> signature;
};

/// Pre-computed streaming payload with commitment hash.
dictionary StreamPayload {
  /// The canonical binary payload bytes to stream in chunks.
  sequence<u8> data;
  /// SHA256 hash of the payload for commitment verification.
  sequence<u8> commitment_hash;
  /// Total size of the payload in bytes.
  u32 payload_size;
};

dictionary ChunkData {
  sequence<u8> chunk;
  boolean is_last;
  u32 remaining_size;
};

enum FingerprintEnrollmentStatus {
  "StatusUnspecified",
  "Incomplete",
  "Complete",
  "NotInProgress",
};

enum FwupFinishRspStatus {
  "Unspecified",
  "Success",
  "SignatureInvalid",
  "VersionInvalid",
  "Error",
  "WillApplyPatch",
  "Unauthenticated",
  "ConfirmationMismatch",
};

