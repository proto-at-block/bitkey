# Git LFS tracking for Android app snapshots
app/android/**/snapshots/**/*.png filter=lfs diff=lfs merge=lfs -text
app/android/app/src/main/res/raw/firmware_update_*.webm filter=lfs diff=lfs merge=lfs -text
app/ios/Wallet/Resources/firmware_update_*.mov filter=lfs diff=lfs merge=lfs -text

# Git LFS tracking for tap placement media assets
app/android/app/src/main/res/raw/coil_placement_*.webm filter=lfs diff=lfs merge=lfs -text
app/ios/Wallet/Resources/coil_placement_*.mov filter=lfs diff=lfs merge=lfs -text

# SQL file syntax highlighting
app/**/*.sq linguist-language=sql
app/**/*.sqm linguist-language=sql

# Git LFS tracking for Rust bdk-ffi libraries
app/rust/bdk-ffi/libs/**/*.a filter=lfs diff=lfs merge=lfs -text
app/rust/bdk-ffi/libs/**/*.so filter=lfs diff=lfs merge=lfs -text
app/rust/bdk-ffi/libs/**/*.dylib filter=lfs diff=lfs merge=lfs -text

# Git LFS tracking for firmware snapshot test images
firmware/test/snapshots/**/*.png filter=lfs diff=lfs merge=lfs -text

# Git LFS tracking for documentation image assets
docs/docs/**/_images/**/*.png filter=lfs diff=lfs merge=lfs -text
docs/docs/**/_images/**/*.jpg filter=lfs diff=lfs merge=lfs -text
docs/docs/**/_images/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
docs/docs/**/_images/**/*.gif filter=lfs diff=lfs merge=lfs -text
docs/docs/**/_images/**/*.webp filter=lfs diff=lfs merge=lfs -text
